{
  "analyzerId": "ckm-json",
  "name": "ckm-json",
  "scenario": "text",
  "description": "Outlook job-search email analytics",
  "tags": {
    "projectId": "",
    "templateId": "emailAnalytics-2026-04-21"
  },
  "config": {
    "returnDetails": true
  },
  "fieldSchema": {
    "name": "OutlookJobEmailAnalysis",
    "descriptions": "Extract job-search signals and required actions from Outlook emails",
    "fields": {
      "company": {
        "type": "string",
        "method": "generate",
        "description": "Legal company name if present; else Unknown"
      },
      "portal": {
        "type": "string",
        "method": "generate",
        "description": "Application portal name such as Simplify, Workday, SmartRecruiters; else Unknown"
      },
      "category": {
        "type": "string",
        "method": "classify",
        "description": "Classify the email into one category",
        "enum": [
          "Job Ad",
          "Recruiter Reach-out",
          "Bot/Auto-Reply",
          "Confirmation of Application",
          "Rejection",
          "Request for Information",
          "Technical Test Request",
          "Personality Test Request",
          "Interview Invitation",
          "Job Offer",
          "Unknown",
          "Not Job Related"
        ]
      },
      "is_automated": {
        "type": "boolean",
        "method": "classify",
        "description": "Whether the email appears automated"
      },
      "deadline": {
        "type": "string",
        "method": "generate",
        "description": "Any explicit deadline date/time if mentioned"
      },
      "urgency": {
        "type": "string",
        "method": "classify",
        "description": "Urgency level based on deadlines",
        "enum": [
          "High",
          "Medium",
          "Low"
        ]
      },
      "interview_type": {
        "type": "string",
        "method": "classify",
        "description": "Interview mode when present",
        "enum": [
          "Online-Live",
          "In-Person",
          "One-Way-Robot",
          "Phone-Call",
          "Unclear",
          "None"
        ]
      },
      "interview_platform": {
        "type": "string",
        "method": "generate",
        "description": "Interview platform e.g. Teams, Zoom; else None"
      },
      "test_platform": {
        "type": "string",
        "method": "generate",
        "description": "Test platform e.g. Codility, LeetCode; else None"
      },
      "test_duration_mins": {
        "type": "integer",
        "method": "generate",
        "description": "Assessment duration in minutes if specified"
      },
      "action_required": {
        "type": "boolean",
        "method": "classify",
        "description": "Whether the candidate must take action"
      },
      "summary": {
        "type": "string",
        "method": "generate",
        "description": "Summarize the next required action in 25 words or fewer"
      }
    }
  }
}
